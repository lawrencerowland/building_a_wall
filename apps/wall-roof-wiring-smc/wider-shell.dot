digraph Shell {
graph [rankdir=LR,bgcolor="#fbfaf5",pad="0.3",nodesep="0.30",ranksep="1",fontname="Arial",label="Wider shell study — resource and state dependencies, not a schedule",labelloc=t];
node [shape=plain,fontname="Arial",fontsize=12];
edge [fontname="Arial",fontsize=10,arrowsize=.65,color="#637768",fontcolor="#34493e"];
Bricks [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Bricks"];
Cement [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Cement"];
ConcreteMix [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Concrete Mix"];
DoorUnits [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Door Units"];
EstablishFoundation [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#edf1e8"><TR><TD COLSPAN="2" BGCOLOR="#d8e4d6"><B>Establish foundation</B></TD></TR><TR><TD PORT="i3" ALIGN="LEFT">Prepared Site</TD><TD PORT="o6" ALIGN="RIGHT">Foundation</TD></TR><TR><TD PORT="i4" ALIGN="LEFT">Concrete Mix</TD><TD></TD></TR><TR><TD PORT="i5" ALIGN="LEFT">Rebar</TD><TD></TD></TR></TABLE>>];
Excavate [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#edf1e8"><TR><TD COLSPAN="2" BGCOLOR="#d8e4d6"><B>Excavate</B></TD></TR><TR><TD PORT="i0" ALIGN="LEFT">Land</TD><TD PORT="o2" ALIGN="RIGHT">Excavators</TD></TR><TR><TD PORT="i1" ALIGN="LEFT">Excavators</TD><TD PORT="o3" ALIGN="RIGHT">Prepared Site</TD></TR></TABLE>>];
Excavators [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Excavators"];
Excavators_Out [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Excavators returned"];
Fasteners [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Fasteners"];
Fitting [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#edf1e8"><TR><TD COLSPAN="2" BGCOLOR="#d8e4d6"><B>Fitting</B></TD></TR><TR><TD PORT="i12" ALIGN="LEFT">Openings</TD><TD PORT="o25" ALIGN="RIGHT">Fitted Elements</TD></TR><TR><TD PORT="i22" ALIGN="LEFT">Window Units</TD><TD></TD></TR><TR><TD PORT="i23" ALIGN="LEFT">Door Units</TD><TD></TD></TR><TR><TD PORT="i24" ALIGN="LEFT">Hardware</TD><TD></TD></TR></TABLE>>];
Framing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#edf1e8"><TR><TD COLSPAN="2" BGCOLOR="#d8e4d6"><B>Framing</B></TD></TR><TR><TD PORT="i11" ALIGN="LEFT">Walls</TD><TD PORT="o14" ALIGN="RIGHT">Frame</TD></TR><TR><TD PORT="i13" ALIGN="LEFT">Fasteners</TD><TD></TD></TR></TABLE>>];
Hardware [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Hardware"];
InspectBuilding [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#edf1e8"><TR><TD COLSPAN="2" BGCOLOR="#d8e4d6"><B>Inspect declared envelope</B></TD></TR><TR><TD PORT="i18" ALIGN="LEFT">Building Shell</TD><TD PORT="o26" ALIGN="RIGHT">Accepted enclosed shell</TD></TR><TR><TD PORT="i25" ALIGN="LEFT">Fitted Elements</TD><TD PORT="o27" ALIGN="RIGHT">Model inspection record</TD></TR></TABLE>>];
InspectionCert [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Model inspection record"];
Land [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Land"];
Rebar [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Rebar"];
Roofing [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#edf1e8"><TR><TD COLSPAN="2" BGCOLOR="#d8e4d6"><B>Roofing</B></TD></TR><TR><TD PORT="i14" ALIGN="LEFT">Frame</TD><TD PORT="o18" ALIGN="RIGHT">Building Shell</TD></TR><TR><TD PORT="i15" ALIGN="LEFT">Trusses</TD><TD PORT="o21" ALIGN="RIGHT">Scaffolding</TD></TR><TR><TD PORT="i16" ALIGN="LEFT">Timber</TD><TD></TD></TR><TR><TD PORT="i17" ALIGN="LEFT">Roofing Material</TD><TD></TD></TR><TR><TD PORT="i20" ALIGN="LEFT">Scaffolding</TD><TD></TD></TR></TABLE>>];
RoofingMaterial [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Roofing Material"];
Sand [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Sand"];
Scaffolding [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Scaffolding"];
Scaffolding_Out [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Scaffolding returned"];
Timber [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Timber"];
Trusses [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Trusses"];
Walling [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#edf1e8"><TR><TD COLSPAN="2" BGCOLOR="#d8e4d6"><B>Walling</B></TD></TR><TR><TD PORT="i6" ALIGN="LEFT">Foundation</TD><TD PORT="o11" ALIGN="RIGHT">Walls</TD></TR><TR><TD PORT="i7" ALIGN="LEFT">Sand</TD><TD PORT="o12" ALIGN="RIGHT">Openings</TD></TR><TR><TD PORT="i8" ALIGN="LEFT">Cement</TD><TD PORT="o20" ALIGN="RIGHT">Scaffolding</TD></TR><TR><TD PORT="i9" ALIGN="LEFT">Water</TD><TD></TD></TR><TR><TD PORT="i10" ALIGN="LEFT">Bricks</TD><TD></TD></TR><TR><TD PORT="i19" ALIGN="LEFT">Scaffolding</TD><TD></TD></TR></TABLE>>];
Water [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Water"];
WeatherproofShell [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Accepted enclosed shell"];
WindowUnits [shape=box,style="rounded,filled",fillcolor="#f8f0df",label="Window Units"];
Land -> Excavate:i0:w [color="#637768",penwidth=1];
Excavators -> Excavate:i1:w [color="#297a76",penwidth=2];
Excavate:o2:e -> Excavators_Out [color="#297a76",penwidth=2];
Excavate:o3:e -> EstablishFoundation:i3:w [color="#637768",penwidth=1];
ConcreteMix -> EstablishFoundation:i4:w [color="#637768",penwidth=1];
Rebar -> EstablishFoundation:i5:w [color="#637768",penwidth=1];
EstablishFoundation:o6:e -> Walling:i6:w [color="#637768",penwidth=1];
Sand -> Walling:i7:w [color="#637768",penwidth=1];
Cement -> Walling:i8:w [color="#637768",penwidth=1];
Water -> Walling:i9:w [color="#637768",penwidth=1];
Bricks -> Walling:i10:w [color="#637768",penwidth=1];
Walling:o11:e -> Framing:i11:w [color="#637768",penwidth=1];
Walling:o12:e -> Fitting:i12:w [color="#637768",penwidth=1];
Fasteners -> Framing:i13:w [color="#637768",penwidth=1];
Framing:o14:e -> Roofing:i14:w [color="#637768",penwidth=1];
Trusses -> Roofing:i15:w [color="#637768",penwidth=1];
Timber -> Roofing:i16:w [color="#637768",penwidth=1];
RoofingMaterial -> Roofing:i17:w [color="#637768",penwidth=1];
Roofing:o18:e -> InspectBuilding:i18:w [color="#637768",penwidth=1];
Scaffolding -> Walling:i19:w [color="#297a76",penwidth=2];
Walling:o20:e -> Roofing:i20:w [color="#297a76",penwidth=2];
Roofing:o21:e -> Scaffolding_Out [color="#297a76",penwidth=2];
WindowUnits -> Fitting:i22:w [color="#637768",penwidth=1];
DoorUnits -> Fitting:i23:w [color="#637768",penwidth=1];
Hardware -> Fitting:i24:w [color="#637768",penwidth=1];
Fitting:o25:e -> InspectBuilding:i25:w [color="#637768",penwidth=1];
InspectBuilding:o26:e -> WeatherproofShell [color="#637768",penwidth=1];
InspectBuilding:o27:e -> InspectionCert [color="#637768",penwidth=1];
}
